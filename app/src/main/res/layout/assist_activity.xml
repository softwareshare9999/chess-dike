<?xml version="1.0" encoding="utf-8"?>
<!-- 背景（默认墨底+细网格）由 AssistActivity 在代码中应用 QiGridDrawable，
     XML 兜底 qi_ink 纯色防闪 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bg_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qi_ink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/assist_title"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/assist_subtitle"
            android:textColor="#B0BEC5"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/assist_steps"
            android:textColor="#FFCC80"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_auto_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/assist_status_not_started"
            android:textColor="#90CAF9"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_overlay_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/assist_btn_overlay"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_notification_permission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/assist_btn_notify"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_start_capture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/assist_btn_capture"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_overlay_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/assist_btn_theme_placeholder"
            android:textSize="15sp" />

        <!-- 切换识别模型（引擎）：页面是固定墨底，但主题是 DayNight——浅色系统模式下
             RadioButton 默认 onSurface 深色文字/深色圈落在墨底上不可读（背景导致字体
             识别不良），故字体固定白色、选中圈固定朱砂（qi_zhu 在墨底 4.5:1） -->
        <RadioGroup
            android:id="@+id/rg_recognizer_engine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_engine_onnx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/qi_zhu"
                android:text="@string/assist_engine_onnx"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rb_engine_yolo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="@color/qi_zhu"
                android:text="@string/assist_engine_yolo"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/assist_compliance"
            android:textColor="#78909C"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
