<?xml version="1.0" encoding="utf-8"?>
<!-- 连线工作页（美学终稿 §3.2）：纸底 + 识别点阵（全 App 唯一语义仪器面）+ 状态行 +
     hero（待机"看穿这一局"，运行态让位实时状态文字）+ 河界线（运行态"线的呼吸"）+
     三步授权清单（几何序号行：完成玉✓实心/待办朱砂描边/未开始灰空心）+
     主按钮（一个动作：开始/停止识别）+ 设置两项 + 合规声明（文案语义全保留）。
     现有交互逻辑一行不删：每秒轮询、setTextIfChanged、启动守卫、热切换、绑定补应用。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bg_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xq_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- 识别点阵：语义仪器面（待机墨恒静/识别中琥珀逐点/等待琥珀/异常警示红） -->
        <com.xqdk.chess.assist.ui.AssistDotGridView
            android:id="@+id/dot_grid"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp" />

        <!-- 状态行：状态点 + 短状态词（长文案截断，全量状态在悬浮窗与 hero） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/state_dot"
                android:layout_width="8dp"
                android:layout_height="8dp" />

            <TextView
                android:id="@+id/tv_auto_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/assist_step_pending"
                android:textColor="@color/xq_muted"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- hero：待机"看穿这一局"（serif），运行态由代码换成实时状态文字（sans） -->
        <TextView
            android:id="@+id/assist_hero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="serif"
            android:letterSpacing="0.02"
            android:text="@string/main_hero"
            android:textColor="@color/xq_ink_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- 河界线：1.5dp 朱砂，运行态进入"线的呼吸"（2.4s） -->
        <com.xqdk.chess.assist.ui.RiverLineView
            android:id="@+id/river_line"
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="16dp" />

        <!-- ===== 三步授权清单（①②可点，③为说明行——动作在下方主按钮） ===== -->

        <LinearLayout
            android:id="@+id/btn_overlay_permission"
            style="@style/StepRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/step_overlay_num"
                style="@style/StepNum"
                android:tag="1"
                android:text="1"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/step_overlay_title"
                    style="@style/StepTitle"
                    android:text="@string/assist_perm_overlay_title"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/step_overlay_hint"
                    style="@style/StepHint"
                    android:text="@string/assist_perm_overlay_hint"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <TextView
                android:id="@+id/step_overlay_chip"
                style="@style/StepChip"
                android:text="@string/assist_step_grant"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btn_notification_permission"
            style="@style/StepRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/step_notify_num"
                style="@style/StepNum"
                android:tag="2"
                android:text="2"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/step_notify_title"
                    style="@style/StepTitle"
                    android:text="@string/assist_perm_notify_title"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/step_notify_hint"
                    style="@style/StepHint"
                    android:text="@string/assist_perm_notify_hint"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <TextView
                android:id="@+id/step_notify_chip"
                style="@style/StepChip"
                android:text="@string/assist_step_grant"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- ③ 屏幕录制：静态说明行（需要时由主按钮拉起授权），运行中由代码点亮 -->
        <LinearLayout
            android:id="@+id/step_capture_row"
            style="@style/StepRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/step_capture_num"
                style="@style/StepNum"
                android:tag="3"
                android:text="3"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="11dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/step_capture_title"
                    style="@style/StepTitle"
                    android:text="@string/assist_perm_capture_title"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/step_capture_hint"
                    style="@style/StepHint"
                    android:text="@string/assist_perm_capture_hint"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <TextView
                android:id="@+id/step_capture_chip"
                style="@style/StepChip"
                android:text="@string/assist_step_ondemand"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- 主按钮：全 App 唯一主操作"开始/停止连线"（终稿原则#1）。
             运行态换警示描边"停止指导"（代码切换 background 资源） -->
        <Button
            android:id="@+id/btn_start_capture"
            style="@style/MainButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="@string/assist_start_capture"
            tools:ignore="HardcodedText" />

        <!-- ===== 设置（两项，与现有配置键对应） ===== -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.08"
            android:text="@string/assist_settings"
            android:textColor="@color/xq_muted"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <!-- 悬浮窗主题：点按循环（深色玻璃→纯黑 OLED→浅色纸感），持久化键不变 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/assist_theme_label"
                android:textColor="@color/xq_ink_text"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btn_overlay_theme"
                style="@style/ValueChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/theme_dark_glass"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- 识别引擎：ONNX 角点式（默认，泛化好）/ YOLO 检测式（回退），运行中热切换。
             RadioButton 芯片化：button=@null + 选中态描边/文字色（chip_segment 同构） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/assist_engine_label"
                android:textColor="@color/xq_ink_text"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

            <RadioGroup
                android:id="@+id/rg_recognizer_engine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_engine_onnx"
                    style="@style/EngineChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/assist_engine_onnx_short"
                    tools:ignore="HardcodedText" />

                <RadioButton
                    android:id="@+id/rb_engine_yolo"
                    style="@style/EngineChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/assist_engine_yolo_short"
                    tools:ignore="HardcodedText" />
            </RadioGroup>
        </LinearLayout>

        <!-- 思考制式：深度制（算到目标深度收束，建议更强）/ 时间制（固定时长收束，
             节奏可预期）。选择后悬浮窗只显示对应制式的切换芯片（深度档或时长档） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/assist_think_mode_label"
                android:textColor="@color/xq_ink_text"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

            <RadioGroup
                android:id="@+id/rg_search_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_mode_depth"
                    style="@style/EngineChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/assist_think_depth"
                    tools:ignore="HardcodedText" />

                <RadioButton
                    android:id="@+id/rb_mode_time"
                    style="@style/EngineChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/assist_think_time"
                    tools:ignore="HardcodedText" />
            </RadioGroup>
        </LinearLayout>

        <!-- 性能诊断：识别分段计时日志开关（默认关，开启后 ONNX 重建并输出五段
             耗时到 logcat）。诊断用途，真机排查识别耗时用，平时关闭零开销 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/assist_bench_label"
                android:textColor="@color/xq_ink_text"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btn_bench_profiling"
                style="@style/ValueChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/switch_off"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- 检查更新：仅手动触发（无启动自检/后台轮询），查 GitHub 正式 stable
             Release 与构建日期比较；结果弹窗/Toast，新版跳 Release 页手动下载 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/assist_update_label"
                android:textColor="@color/xq_ink_text"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btn_check_update"
                style="@style/ValueChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_check_button"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- 合规声明（原段落文案语义全保留） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/assist_compliance"
            android:textColor="@color/xq_muted"
            android:textSize="11sp"
            tools:ignore="HardcodedText" />

        <!-- 底部入口：帮助（本地帮助页）/ 关于（本地对话框）——原主页文字入口迁入 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_help"
                style="@style/MainTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/main_help" />

            <Button
                android:id="@+id/button_about"
                style="@style/MainTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="@string/main_about" />

            <Button
                android:id="@+id/button_language"
                style="@style/MainTextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="@string/language" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
